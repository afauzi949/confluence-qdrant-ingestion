# ---- Confluence ----
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=II
CONFLUENCE_SPACE_ID=131465483
# page dianggap "berubah" bila lastmodified >= now(-N d). Harus > interval scheduler.
MODIFIED_WINDOW_DAYS=3
SEARCH_PAGE_LIMIT=50
TRASHED_PAGE_LIMIT=100

# ---- Metadata yang dikirim ke convert API (sama seperti node Convert Markdown) ----
PAGE_TYPE=page

# ---- Convert HTML -> Markdown (API eksternal) ----
CONVERT_API_URL=

# ---- Chunking ----
# api   = POST ke CHUNK_API_URL (sama seperti workflow n8n)
# local = tiktoken di proses ini (algoritma sama dengan chunking.py)
CHUNK_MODE=api
CHUNK_API_URL=
CHUNK_SIZE=6000
CHUNK_OVERLAP=200

# ---- Embedding dense (API eksternal, OpenAI-compatible) ----
EMBEDDING_API_URL=https://ai.sumopod.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Qdrant ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=space_alto
# sparse BM25 dihitung oleh Qdrant (inference object), seperti node Assemble Qdrant Point
QDRANT_SPARSE_MODEL=qdrant/bm25

# ---- Scheduler (harian) ----
SCHEDULE_HOUR=1
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Jakarta
RUN_ON_START=false

# ---- HTTP ----
HTTP_TIMEOUT_SECONDS=120
HTTP_MAX_TRIES=3
HTTP_RETRY_WAIT_SECONDS=5

LOG_LEVEL=INFO
